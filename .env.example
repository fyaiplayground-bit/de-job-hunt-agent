# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Claude API (create at the Claude Console; set a monthly spending limit)
ANTHROPIC_API_KEY=
# Model the agents use and how hard it thinks (low, medium, high, xhigh, max)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# The daily run briefs that day's new in-scope postings with jd-analysis (false = skip the step)
JD_ANALYSIS_ENABLED=true
JD_ANALYSIS_DAILY_MAX=50

# Postgres (Docker)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=jobhunt
POSTGRES_USER=jobhunt
POSTGRES_PASSWORD=

# S3 backup — personal AWS account only, never a work account
# Backups stay off until all three of AWS_PROFILE, S3_BACKUP_BUCKET and
# AWS_BACKUP_ACCOUNT_ID are set (decision #44; steps in docs/AWS_SETUP.md).
AWS_PROFILE=
S3_BACKUP_BUCKET=
# The 12-digit personal account id: a backup is refused if the profile belongs to another.
AWS_BACKUP_ACCOUNT_ID=
AWS_REGION=us-west-2

# Airflow in Docker (decision #46): two long random strings, shared by Airflow's parts so they
# trust each other. Make each with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
AIRFLOW_SECRET_KEY=

# Sources
GREENHOUSE_ENABLED=true
LEVER_ENABLED=true
FREEHIRE_ENABLED=true
# LinkedIn public listings: against LinkedIn's terms for automated access.
# Personal use, low volume only. Off by default.
LINKEDIN_PUBLIC_ENABLED=false
LINKEDIN_MAX_REQUESTS_PER_DAY=50

# Daily run reports: dates in this time zone
REPORT_TIMEZONE=America/Los_Angeles

# Candidate profile the agents read (resume, Evidence Bank, Applicant Profile).
# The fictional sample until Milestone 5, then private
PROFILE_DIR=data/sample
