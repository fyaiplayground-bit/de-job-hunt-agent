# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Claude API (create at the Claude Console; set a monthly spending limit)
ANTHROPIC_API_KEY=

# Postgres (Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobhunt
POSTGRES_USER=jobhunt
POSTGRES_PASSWORD=

# S3 backup — personal AWS account only, never a work account
AWS_PROFILE=
S3_BACKUP_BUCKET=

# Sources
GREENHOUSE_ENABLED=true
LEVER_ENABLED=true
FREEHIRE_ENABLED=true
# LinkedIn public listings: against LinkedIn's terms for automated access.
# Personal use, low volume only. Off by default.
LINKEDIN_PUBLIC_ENABLED=false
LINKEDIN_MAX_REQUESTS_PER_DAY=50
